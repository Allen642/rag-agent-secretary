# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不会提交到 GitHub。
# ============================================================

# ---- DeepSeek OpenAI 兼容接口 ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 本地存储 ----
# 向量库（运行时数据，可随时从文档重建）
CHROMA_DIR=data/runtime/chroma
# 个人文档目录：放自己的 Markdown/TXT 笔记
DOCS_DIR=data/docs

# ---- 本地 CPU Embedding ----
# 首次运行会从 Hugging Face（或镜像）下载约 100MB 权重
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 国内网络访问 huggingface.co 经常超时，默认使用镜像
# 如需官方源，改成 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# 本项目只支持 cpu；代码中会拒绝非 cpu 值，避免误触发 CUDA
EMBEDDING_DEVICE=cpu

# 模型下载完成后可打开下面两个开关，强制离线运行
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ---- 通知推送（可选）----
# none：只打印到终端（默认）；wecom：推送到企业微信「应用」
NOTIFY_CHANNEL=none
# 企业微信管理后台 → 我的企业 → 企业信息 → 企业 ID
WECOM_CORP_ID=your-corp-id
# 应用管理 → 自建应用 → AgentId（纯数字）
WECOM_AGENT_ID=1000002
# 自建应用的 Secret；不要提交真实值
WECOM_SECRET=your-app-secret
# 接收人：@all 表示应用可见范围内全部成员，也可填 UserID，多个用 | 分隔
WECOM_USER_ID=@all
