# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不会提交到 GitHub。
# ============================================================

# ---- 主模型 provider ----
# 主模型：deepseek / zhipu
MODEL_PROVIDER=zhipu
# 智谱 API（MODEL_PROVIDER=zhipu 时必填）
ZHIPU_API_KEY=80cc44b093ee425eb5d719114794135e.oaxRwch1XxQP42pu
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---- DeepSeek OpenAI 兼容接口 ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- DeepSeek 推理模式（可选）----
# default：不显式传参，使用服务端默认行为（推荐先保持默认）
# enabled：开启思考模式；disabled：关闭思考模式
# 注意：开启思考模式时 temperature=0 不会生效
DEEPSEEK_THINKING=default
# 思考强度：low / high / max；留空表示不传，使用服务端默认
DEEPSEEK_REASONING_EFFORT=

# ---- 本地存储 ----
# 向量库（运行时数据，可随时从文档重建）
CHROMA_DIR=data/runtime/chroma
# 个人文档目录：放自己的 Markdown/TXT 笔记
DOCS_DIR=data/docs
# 会话历史 SQLite 路径；留空使用 data/runtime/conversations.db
CONVERSATION_DB=data/runtime/conversations.db

# ---- 本地 CPU Embedding ----
# 首次运行会从 Hugging Face（或镜像）下载约 100MB 权重
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 国内网络访问 huggingface.co 经常超时，默认使用镜像
# 如需官方源，改成 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# 本项目只支持 cpu；代码中会拒绝非 cpu 值，避免误触发 CUDA
EMBEDDING_DEVICE=cpu

# 模型下载完成后可打开下面两个开关，强制离线运行
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ---- 通知推送（可选）----
# none：只打印到终端（默认）；wecom：推送到企业微信「应用」
NOTIFY_CHANNEL=none
# 企业微信管理后台 → 我的企业 → 企业信息 → 企业 ID
WECOM_CORP_ID=your-corp-id
# 应用管理 → 自建应用 → AgentId（纯数字）
WECOM_AGENT_ID=1000002
# 自建应用的 Secret；不要提交真实值
WECOM_SECRET=your-app-secret
# 接收人：@all 表示应用可见范围内全部成员，也可填 UserID，多个用 | 分隔
WECOM_USER_ID=@all

# ---- 企业微信接收消息服务器（可选，Slice 6b1）----
# 应用管理 → 自建应用 → 接收消息 → 设置 API 接收
# Token：自行随机生成，与后台填写的保持一致；不要提交真实值
WECOM_TOKEN=your-wecom-token
# EncodingAESKey：43 位，与 Token 一起生成；不要提交真实值
WECOM_ENCODING_AES_KEY=your-encoding-aes-key

# ===== 企业微信群机器人（家庭宽带 / 无固定 IP 时使用）=====
# 群设置 -> 群机器人 -> 添加 -> 复制 Webhook 地址
# 配置后优先于应用消息，回复会发到该群
WECOM_ROBOT_WEBHOOK=

# ---- 企业微信触发自动改代码（可选，L2 MVP）----
# 允许在企业微信里发送 /code <需求> 的成员 UserID，多个用英文逗号分隔。
# 留空表示谁都不能触发；只有这里列出的成员才会进入自动改代码流程。
# 注意：自动改代码会在 data/runtime/auto-edit/ 建隔离 worktree、跑 pytest，
# 通过后推送 auto/<timestamp> 分支，仍然需要人工 review 后 merge。
SELF_EDIT_USER_IDS=
